@page "/join"
@page "/join/{RoomCode}"
@implements IAsyncDisposable
@using ImagoraGame.Client.Blazor.Rooms
@using ImagoraGame.Contracts.Rooms
@inject MobileJoinClient JoinClient
@inject MobileRoomClient MobileRoomClient

<PageTitle>Unirse a sala</PageTitle>

<main class="mobile-join">
    @if (_lobby is null)
    {
        <section class="join-panel" aria-labelledby="join-title">
            <p class="eyebrow">ImagoraGame</p>
            <h1 id="join-title">Unirse a sala</h1>

            <EditForm Model="_form" OnValidSubmit="JoinRoomAsync" FormName="mobile-join">
                <DataAnnotationsValidator />

                <div class="field-group">
                    <label for="room-code">Código de sala</label>
                    <InputText id="room-code"
                               class="text-input room-code-input"
                               autocomplete="off"
                               autocapitalize="characters"
                               disabled="@HasRoomCodeFromUrl"
                               @bind-Value="_form.RoomCode" />
                    <ValidationMessage For="@(() => _form.RoomCode)" />
                </div>

                <div class="field-group">
                    <label for="player-name">Tu nombre</label>
                    <InputText id="player-name"
                               class="text-input"
                               autocomplete="name"
                               @bind-Value="_form.PlayerName" />
                    <ValidationMessage For="@(() => _form.PlayerName)" />
                </div>

                <button class="primary-action" type="submit" disabled="@_isJoining">
                    @(_isJoining ? "Uniendo..." : "Entrar")
                </button>

                @if (_errorMessage is not null)
                {
                    <p class="error-message" role="alert">@_errorMessage</p>
                }
            </EditForm>
        </section>
    }
    else
    {
        <section class="lobby-panel" aria-labelledby="lobby-title">
            <p class="eyebrow">Sala @_lobby.RoomCode</p>
            <h1 id="lobby-title">@_lobby.PlayerName</h1>

            @if (ShowsStorytellerAction)
            {
                <div class="player-action" aria-labelledby="storyteller-action-title">
                    <h2 id="storyteller-action-title">Elige tu carta</h2>
                    <p class="mobile-status">Selecciona una carta de tu mano y escribe la pista para la ronda.</p>

                    <div class="hand-grid" aria-label="Cartas de tu mano">
                        @foreach (var card in MobileRoomClient.PrivateState!.Player.Hand)
                        {
                            <button type="button"
                                    class="card-choice @(card.CardId == _selectedStorytellerCardId ? "selected" : null)"
                                    aria-pressed="@(card.CardId == _selectedStorytellerCardId)"
                                    @onclick="() => SelectStorytellerCard(card.CardId)">
                                <span>Carta</span>
                                <strong>@card.CardId</strong>
                            </button>
                        }
                    </div>

                    <div class="field-group">
                        <label for="storyteller-clue">Pista</label>
                        <InputText id="storyteller-clue"
                                   class="text-input"
                                   autocomplete="off"
                                   @bind-Value="_storytellerClue" />
                    </div>

                    <button class="primary-action"
                            type="button"
                            disabled="@(!CanSubmitStorytellerCard)"
                            @onclick="SubmitStorytellerCardAsync">
                        @(MobileRoomClient.IsChoosingStorytellerCard ? "Enviando..." : "Enviar pista")
                    </button>
                </div>
            }
            else if (ShowsGuesserSubmissionAction)
            {
                <div class="player-action" aria-labelledby="guesser-submission-title">
                    <h2 id="guesser-submission-title">Entrega tu carta</h2>

                    <div class="round-clue" aria-label="Pista de la ronda">
                        <span>Pista</span>
                        <strong>@MobileRoomClient.PrivateState!.Room.Clue</strong>
                    </div>

                    <p class="mobile-status">Selecciona una carta de tu mano para entregarla a la ronda.</p>

                    <div class="hand-grid" aria-label="Cartas de tu mano">
                        @foreach (var card in MobileRoomClient.PrivateState!.Player.Hand)
                        {
                            <button type="button"
                                    class="card-choice @(card.CardId == _selectedGuessCardId ? "selected" : null)"
                                    aria-pressed="@(card.CardId == _selectedGuessCardId)"
                                    @onclick="() => SelectGuessCard(card.CardId)">
                                <span>Carta</span>
                                <strong>@card.CardId</strong>
                            </button>
                        }
                    </div>

                    <button class="primary-action"
                            type="button"
                            disabled="@(!CanSubmitGuessCard)"
                            @onclick="SubmitGuessCardAsync">
                        @(MobileRoomClient.IsSubmittingGuessCard ? "Enviando..." : "Enviar carta")
                    </button>
                </div>
            }
            else
            {
                <p class="mobile-status">@MobileStatusMessage</p>
            }

            @if (MobileRoomClient.ErrorMessage is not null)
            {
                <p class="error-message" role="alert">@MobileRoomClient.ErrorMessage</p>
            }
        </section>
    }
</main>

@code {
    [Parameter]
    public string? RoomCode { get; set; }

    private readonly JoinRoomForm _form = new();
    private readonly Guid _playerId = Guid.NewGuid();
    private MobileLobbyState? _lobby;
    private bool _isJoining;
    private string? _errorMessage;
    private string? _selectedStorytellerCardId;
    private string? _selectedGuessCardId;
    private string _storytellerClue = string.Empty;

    private bool HasRoomCodeFromUrl => !string.IsNullOrWhiteSpace(RoomCode);

    private string MobileStatusMessage
    {
        get
        {
            var privateState = MobileRoomClient.PrivateState;
            if (privateState?.Room.Phase == RoomPhase.GuessersSubmitting)
            {
                return privateState.Player.IsCurrentStoryteller
                    ? "Pista enviada. Esperando a que el resto elija su carta."
                    : "Carta enviada. Esperando a que el resto termine.";
            }

            if (privateState is not null &&
                privateState.Room.Phase != RoomPhase.WaitingForPlayers)
            {
                return "La partida ha empezado. Mantén esta pantalla lista para tu próximo turno.";
            }

            return "Jugador unido. Esperando a que la TV inicie la partida.";
        }
    }

    private bool ShowsStorytellerAction
    {
        get
        {
            var privateState = MobileRoomClient.PrivateState;
            return privateState?.Room.Phase == RoomPhase.StorytellerChoosing &&
                privateState.Player.IsCurrentStoryteller;
        }
    }

    private bool ShowsGuesserSubmissionAction
    {
        get
        {
            var privateState = MobileRoomClient.PrivateState;
            return privateState?.Room.Phase == RoomPhase.GuessersSubmitting &&
                !privateState.Player.IsCurrentStoryteller;
        }
    }

    private bool CanSubmitStorytellerCard =>
        ShowsStorytellerAction &&
        !MobileRoomClient.IsChoosingStorytellerCard &&
        !string.IsNullOrWhiteSpace(_selectedStorytellerCardId) &&
        !string.IsNullOrWhiteSpace(_storytellerClue);

    private bool CanSubmitGuessCard =>
        ShowsGuesserSubmissionAction &&
        !MobileRoomClient.IsSubmittingGuessCard &&
        !string.IsNullOrWhiteSpace(_selectedGuessCardId);

    protected override void OnParametersSet()
    {
        if (HasRoomCodeFromUrl)
        {
            _form.RoomCode = RoomCode!.Trim().ToUpperInvariant();
        }
    }

    private async Task JoinRoomAsync()
    {
        if (_isJoining)
        {
            return;
        }

        _isJoining = true;
        _errorMessage = null;

        try
        {
            _lobby = await JoinClient.JoinAsync(
                _form.RoomCode,
                _form.PlayerName,
                _playerId);
            await MobileRoomClient.ConnectAsync(_lobby);
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "La operación fue cancelada.";
        }
        catch
        {
            _errorMessage = "No se pudo unir a la sala. Comprueba que el servidor está disponible.";
        }
        finally
        {
            _isJoining = false;
        }
    }

    protected override void OnInitialized()
    {
        MobileRoomClient.StateChanged += HandleMobileRoomChanged;
    }

    private void HandleMobileRoomChanged()
    {
        if (MobileRoomClient.PrivateState?.Room.Phase != RoomPhase.StorytellerChoosing)
        {
            _selectedStorytellerCardId = null;
            _storytellerClue = string.Empty;
        }

        if (MobileRoomClient.PrivateState?.Room.Phase != RoomPhase.GuessersSubmitting)
        {
            _selectedGuessCardId = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectStorytellerCard(string cardId)
    {
        _selectedStorytellerCardId = cardId;
    }

    private void SelectGuessCard(string cardId)
    {
        _selectedGuessCardId = cardId;
    }

    private async Task SubmitStorytellerCardAsync()
    {
        if (!CanSubmitStorytellerCard || _selectedStorytellerCardId is null)
        {
            return;
        }

        await MobileRoomClient.ChooseStorytellerCardAsync(
            _selectedStorytellerCardId,
            _storytellerClue);
    }

    private async Task SubmitGuessCardAsync()
    {
        if (!CanSubmitGuessCard || _selectedGuessCardId is null)
        {
            return;
        }

        await MobileRoomClient.SubmitGuessCardAsync(_selectedGuessCardId);
    }

    public async ValueTask DisposeAsync()
    {
        MobileRoomClient.StateChanged -= HandleMobileRoomChanged;
        await MobileRoomClient.DisposeAsync();
    }

    private sealed class JoinRoomForm
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Introduce el código de sala.")]
        public string RoomCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Introduce tu nombre.")]
        [System.ComponentModel.DataAnnotations.StringLength(
            40,
            MinimumLength = 1,
            ErrorMessage = "El nombre debe tener entre 1 y 40 caracteres.")]
        public string PlayerName { get; set; } = string.Empty;
    }
}
